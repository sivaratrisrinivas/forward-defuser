# Copy to .env for local runs. In the cloud, set these as Secret Manager secrets / Fly secrets.
ENV=dev
PUBLIC_BASE_URL=https://your-service.run.app
DATABASE_URL=postgresql://fd:fd@localhost:5432/fd
REDIS_URL=redis://localhost:6379/0

# Generate with: uv run python scripts/gen_keys.py
DATA_KEY=
HASH_PEPPER=
ADMIN_TOKEN=
RETENTION_DAYS=30

# LLM (Claude). MODEL_MAIN does investigation + drafting; MODEL_CHEAP does triage + language detection.
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5
# USD per million tokens (input:output), used for budgets and the cost dashboard. Check current pricing.
MODEL_PRICES=claude-opus-5-5=4:20,claude-haiku-5-5=0.1:0.5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_CHAT_ID=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Tools
GOOGLE_API_KEY=          # Fact Check Tools API, Vision API, Safe Browsing API, Speech-to-Text
BRAVE_API_KEY=           # Brave Search API (web_search + official-source lookups)

# Object storage (S3 compatible; GCS works through its S3 interoperability endpoint)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Budgets
MAX_STEPS_PER_MESSAGE=8
MAX_COST_PER_MESSAGE_USD=0.25
MAX_COST_PER_USER_DAY_USD=1.0
MAX_MESSAGES_PER_USER_DAY=40
MAX_MESSAGES_PER_USER_MINUTE=5
MAX_COST_GLOBAL_DAY_USD=50

OTEL_EXPORTER_OTLP_ENDPOINT=

# Reply languages with templates (src/defuser/i18n/*.yaml). ta/te/bn/mr/hi templates are unreviewed drafts.
SUPPORTED_LANGS=en,hi,hinglish,ta,te,bn,mr
